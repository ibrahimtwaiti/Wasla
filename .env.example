# Export these variables in your shell or use docker compose --env-file .env.
WASLA_ENV=development
WASLA_DB=/data/wasla.sqlite3
WASLA_ORIGIN=http://localhost:8000
# HTTPS origin and production enable Secure cookies. Never use development on the internet.
# WASLA_ENV=production
# WASLA_ORIGIN=https://your-domain.example
# Provider integration remains disabled unless all values and per-channel token exist.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# WASLA_WA_TOKEN_COMPANY_ONE= (server environment only)

# Serverless: use a Neon pooled DATABASE_URL; never put secrets in Git.
# DATABASE_URL=postgresql://<role>:<password>@<host>-pooler/<database>?sslmode=require
# DATABASE_URL_UNPOOLED=... (operator migrations only)
# WASLA_WORKER_SECRET=... (random 32+ character token, only on server)

# Optional initial administrator activation; disabled without both values.
# Generate a random 40+ character token and set an expiry Unix timestamp.
# WASLA_SETUP_TOKEN=...
# WASLA_SETUP_EXPIRES=...
# Open /setup#TOKEN privately. Setup is permanently rejected after a provider exists.

# V2 optional Instagram Login. Secrets must be provisioned outside Git.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WASLA_TOKEN_ENCRYPTION_KEY=
# Per-account manual credentials: WASLA_CHANNEL_<ACCOUNT_ID_UPPERCASE>_TOKEN
# Separate PRIVATE media bucket and approved scanner; never reuse backup credentials.
WASLA_MEDIA_ENDPOINT=
WASLA_MEDIA_BUCKET=
WASLA_MEDIA_ACCESS_KEY_ID=
WASLA_MEDIA_SECRET_ACCESS_KEY=
WASLA_MEDIA_SCANNER_URL=
WASLA_MEDIA_SCANNER_TOKEN=
