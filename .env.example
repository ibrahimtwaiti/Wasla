# Export these variables in your shell or use docker compose --env-file .env.
WASLA_ENV=development
WASLA_DB=/data/wasla.sqlite3
WASLA_ORIGIN=http://localhost:8000
# HTTPS origin and production enable Secure cookies. Never use development on the internet.
# WASLA_ENV=production
# WASLA_ORIGIN=https://your-domain.example
# Provider integration remains disabled unless all values and per-channel token exist.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# WASLA_WA_TOKEN_COMPANY_ONE= (server environment only)
